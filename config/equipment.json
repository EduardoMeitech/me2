        "process_01": {
          "db": 100,
          "offset": 54,
          "size": 1,
          "type": "bool",
          "bit": 0,
          "description": "DB100.DBX54.0 — GVL_ME2.bProcess_01"
        },
        "process_02": {
          "db": 100,
          "offset": 54,
          "size": 1,
          "type": "bool",
          "bit": 1,
          "description": "DB100.DBX54.1 — GVL_ME2.bProcess_02"
        },
        "process_03": {
          "db": 100,
          "offset": 54,
          "size": 1,
          "type": "bool",
          "bit": 2,
          "description": "DB100.DBX54.2 — GVL_ME2.bProcess_03"
        },
        "process_04": {
          "db": 100,
          "offset": 54,
          "size": 1,
          "type": "bool",
          "bit": 3,
          "description": "DB100.DBX54.3 — GVL_ME2.bProcess_04"
        },
        "process_05": {
          "db": 100,
          "offset": 54,
          "size": 1,
          "type": "bool",
          "bit": 4,
          "description": "DB100.DBX54.4 — GVL_ME2.bProcess_05"
        },
        "process_06": {
          "db": 100,
          "offset": 54,
          "size": 1,
          "type": "bool",
          "bit": 5,
          "description": "DB100.DBX54.5 — GVL_ME2.bProcess_06"
        },
        "process_07": {
          "db": 100,
          "offset": 54,
          "size": 1,
          "type": "bool",
          "bit": 6,
          "description": "DB100.DBX54.6 — GVL_ME2.bProcess_07"
        },
        "process_08": {
          "db": 100,
          "offset": 54,
          "size": 1,
          "type": "bool",
          "bit": 7,
          "description": "DB100.DBX54.7 — GVL_ME2.bProcess_08"
        }
      }
    },

    "alerts": {
      "uptime_status_code": 18,
      "uptime_variants": [18],
      "downtime_l1_min": 10,
      "downtime_l2_min": 15,
      "notify_l1": "operations",
      "notify_l2": "management"
    }
  },

  "notification_groups": {
    "operations": {
      "description": "Equipe operacional — recebe alerta L1 (parada > threshold)",
      "emails": [
        "operador1@meitech.com.br",
        "operador2@meitech.com.br",
        "supervisor.linha@meitech.com.br"
      ]
    },
    "management": {
      "description": "Gestao — recebe alerta L2 (escalacao por parada prolongada)",
      "emails": [
        "gerente.producao@meitech.com.br",
        "diretor.operacoes@meitech.com.br",
        "eduardo@meitech.com.br"
      ]
    }
  },

  "defaults": {
    "poll_interval_s": 1.0,
    "timezone": "America/Sao_Paulo",
    "shifts": {
      "T100": { "name": "Turno 1", "start": "05:00", "end": "13:29" },
      "T200": { "name": "Turno 2", "start": "13:30", "end": "21:59" },
