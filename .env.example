# ME2 — Environment Variables
# Copy to .env and fill in the values. Never commit .env!

# --- Database (PostgreSQL) ---
POSTGRES_USER=me2
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=me2
DATABASE_URL=postgresql+asyncpg://me2:change_me_in_production@localhost:5432/me2

# --- JWT Auth ---
JWT_SECRET_KEY=change_me_to_a_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO

# --- Collector ---
COLLECTOR_CYCLE_SECONDS=1
EQUIPMENT_CONFIG_PATH=../config/equipment.json
SQLITE_BUFFER_PATH=./collector/buffer.db

# --- Email Alerts (SMTP) ---
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@meitech.com.br
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=me2@meitech.com.br
SMTP_FROM_NAME=ME2 Alertas

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live
